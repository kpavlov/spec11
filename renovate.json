{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "2 days",
  "packageRules": [
    {
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "ignoreTests": false
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "automerge": true
    }
  ]
}
